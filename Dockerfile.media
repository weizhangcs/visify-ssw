# Dockerfile.media
# syntax=docker/dockerfile:1
FROM crpi-34v4qt829vtet2cy.cn-hangzhou.personal.cr.aliyuncs.com/vss_base/python:3.12-slim

# 1. 定义镜像源参数
ARG APT_MIRROR=mirrors.aliyun.com
# 建议使用阿里云 pypi 源，和您的基础镜像网络环境更匹配，或者继续用清华源
ARG PIP_MIRROR_URL=https://mirrors.aliyun.com/pypi/simple/

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_NO_CACHE_DIR=1

# [优化] 尽早创建用户，后续 COPY 时直接指定所有者
RUN useradd -m appuser

# 2. [系统依赖] 换源并安装
RUN sed -i "s|deb.debian.org|$APT_MIRROR|g" /etc/apt/sources.list.d/debian.sources && \
    sed -i "s|security.debian.org|$APT_MIRROR|g" /etc/apt/sources.list.d/debian.sources && \
    apt-get update && \
    apt-get install -y --no-install-recommends \
        ffmpeg \
        gcc \
        libsndfile1 \
        libpq-dev \
        fonts-wqy-zenhei \
        fonts-noto-cjk \
    && apt-get clean && \
    rm -rf /var/lib/apt/lists/*

WORKDIR /app

# -----------------------------------------------------------
# 🛑 [核心修复] 全局配置 pip 镜像源
# -----------------------------------------------------------
# 这行命令确保了后续所有的 pip install (无论本地还是在线)
# 只要涉及下载，全部强制走国内镜像！
RUN pip config set global.index-url $PIP_MIRROR_URL && \
    pip config set global.timeout 1000

# -----------------------------------------------------------
# 🚀 [第一步] 离线安装 PyTorch 本体 + 在线极速下载依赖
# -----------------------------------------------------------
# 现在，pip 解析 sympy 等依赖时，会飞快地从阿里云/清华下载
# 不再需要手动加 -i 参数，也不再需要 --default-timeout
# [优化] 使用 BuildKit 挂载安装，避免将巨大的 whl 包拷贝进镜像层
RUN --mount=type=bind,source=local_packages,target=/tmp/packages \
    pip install --no-cache-dir /tmp/packages/torch-*.whl /tmp/packages/torchvision-*.whl

# -----------------------------------------------------------
# 🚀 [第二步] 安装其余依赖
# -----------------------------------------------------------
COPY requirements.base.txt .
COPY requirements.media.txt .

# 这里也不需要再加 -i 了，因为全局已经配好了
RUN pip install --upgrade pip && \
    pip install --no-cache-dir -r requirements.media.txt

# [变更] 离线模式：将本地预下载的模型复制到镜像中
# 对应 scripts/download_model.py 下载的目录
# [优化] COPY 时直接指定用户，避免后续 chown 产生 2.7GB 的冗余层
COPY --chown=appuser:appuser local_models /app/local_models

# [优化] 显式拷贝代码，替代 COPY . .，防止 local_models 被重复拷贝
COPY --chown=appuser:appuser manage.py .
COPY --chown=appuser:appuser visify_ssw/ visify_ssw/
COPY --chown=appuser:appuser apps/ apps/
COPY --chown=appuser:appuser templates/ templates/
COPY --chown=appuser:appuser staticfiles/ staticfiles/
COPY --chown=appuser:appuser static_build/ static_build/

# 如果有其他目录(如 templates, static)请在此处添加

USER appuser

# Worker 不需要暴露端口，但可以保留 Healthcheck 逻辑(如果需要)
CMD ["celery", "-A", "visify_ssw", "worker", "-l", "info"]